# Copy this file to .env and fill in the values.
# Never commit .env to GitHub.

PORT=3000
NODE_ENV=development
FIRST_NAME=Your
LAST_NAME=Name

# Personal access token, used only in development: middleware/dev-token-auth.js
# seeds a Vimeo session from it so `node --watch` restarts don't force a re-auth.
# Optional — leave blank to always use the real OAuth flow. Ignored entirely when
# NODE_ENV is not "development".
# Generate at https://developer.vimeo.com/apps under "Authentication".
VIMEO_TOKEN=

# Session secret — required; must be a long random string.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Vimeo OAuth app credentials — required for per-user OAuth.
# Create an app at https://developer.vimeo.com/apps and add a redirect URI there.
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
# Must match exactly what you registered in the Vimeo app settings:
#   Local dev:  http://localhost:3000/auth/vimeo/callback
#   Production: https://yourdomain.com/auth/vimeo/callback
VIMEO_REDIRECT_URI=
# Space-separated scopes. "public private" covers most read/write operations.
VIMEO_SCOPES=public private
