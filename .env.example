# Copy this file to .env and fill in the values.
# Never commit .env to GitHub.

PORT=3000
NODE_ENV=development

# Session secret — required; must be a long random string.
# The demo itself is stateless, but express-session is wired up in server.js
# and will throw at startup if this is missing.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
