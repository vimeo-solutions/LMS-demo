<div class="vimeo-auth-widget">
  <% if (vimeoAuth) { %>
    <div class="vimeo-auth-widget__connected">
      <span class="vimeo-auth-widget__name" title="<%= vimeoAuth.userName %>"><%= vimeoAuth.userName %></span>
      <% if (vimeoAuth.devFallback) { %>
        <span class="vimeo-auth-widget__dev-badge" title="Signed in with VIMEO_TOKEN from .env — not a real OAuth session">dev</span>
      <% } %>
      <form method="POST" action="/auth/vimeo/logout" class="vimeo-auth-widget__logout-form">
        <button type="submit" class="vimeo-auth-widget__disconnect" aria-label="Disconnect Vimeo account">Disconnect</button>
      </form>
    </div>
  <% } else { %>
    <a href="/auth/vimeo/start?returnTo=<%= encodeURIComponent(locals.currentPath || '/') %>" class="vimeo-auth-widget__connect btn btn--ghost btn--sm">
      Connect Vimeo
    </a>
  <% } %>
</div>
