<%
  // Props: code (string), language (optional string, e.g. "json", "bash")
  const lang = locals.language || 'text';
%>
<div class="code-block">
  <div class="code-block__header">
    <span class="code-block__lang"><%= lang %></span>
    <button class="code-block__copy btn btn--ghost btn--sm" data-copy-target>Copy</button>
  </div>
  <pre class="code-block__pre"><code class="code-block__code"><%= code %></code></pre>
</div>
