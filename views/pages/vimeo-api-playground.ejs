<div class="page page--vimeo-api-playground">
  <div class="api-shell">

    <aside class="api-sidebar" id="api-sidebar">
      <div class="api-sidebar__search">
        <div class="form-group" style="margin:0">
          <input class="form-group__input" type="text" id="api-search" placeholder="Search endpoints…" autocomplete="off" />
        </div>
      </div>
      <nav id="api-nav" class="api-nav"></nav>
      <div class="api-sidebar__filter">
        <label class="api-filter-label">
          <input type="checkbox" id="api-hide-private" class="api-filter-checkbox" />
          <span>Hide private endpoints</span>
        </label>
      </div>
    </aside>

    <main class="api-main" id="api-main">
      <div class="empty-state" id="api-empty">
        <div class="empty-state__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M5 3l14 9-14 9V3z"/>
          </svg>
        </div>
        <p class="empty-state__heading">Select an endpoint to try</p>
        <p class="empty-state__body">Fill in the parameters and send a real authenticated request to the Vimeo API.</p>
      </div>
      <div id="api-doc" class="api-doc-inner hidden"></div>
    </main>

  </div>
</div>

<div class="toast-container" id="toast-container">
  <div class="toast" id="toast"></div>
</div>
