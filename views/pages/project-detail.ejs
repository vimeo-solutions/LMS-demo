<div class="page page--detail">
  <div class="container">

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/" class="breadcrumb__link">Home</a>
      <span class="breadcrumb__sep">›</span>
      <a href="<%= project.categoryUrl %>" class="breadcrumb__link"><%= project.category %></a>
      <span class="breadcrumb__sep">›</span>
      <span class="breadcrumb__current"><%= project.title %></span>
    </nav>

    <div class="detail-layout">

      <!-- Main content -->
      <div class="detail-main">

        <div class="detail-header">
          <%- include('../partials/status-pill', { status: project.status }) %>
          <span class="detail-header__category"><%= project.category %></span>
          <% if (project.visibility === 'Internal') { %>
            <span class="detail-header__visibility pill pill--internal">Internal</span>
          <% } else if (project.visibility === 'Customer') { %>
            <span class="detail-header__visibility pill pill--customer">Customer</span>
          <% } %>
        </div>

        <h1 class="detail-title"><%= project.title %></h1>
        <p class="detail-desc"><%= project.description %></p>

        <%- include('../partials/tag-list', { tags: project.tags }) %>

        <% if (project.notes) { %>
          <section class="detail-section">
            <h2 class="detail-section__heading">Notes</h2>
            <p class="detail-section__body"><%= project.notes %></p>
          </section>
        <% } %>

        <!-- Placeholder for project-specific content -->
        <section class="detail-section">
          <h2 class="detail-section__heading">Overview</h2>
          <p class="detail-section__body detail-section__body--muted">
            No detailed overview added yet. Edit <code>data/projects.js</code> to add notes, or build a custom detail view at <code>views/pages/project-detail.ejs</code>.
          </p>
        </section>

      </div>

      <!-- Sidebar -->
      <aside class="detail-sidebar">

        <div class="detail-sidebar__panel card">
          <h3 class="detail-sidebar__heading">Details</h3>
          <dl class="detail-meta">
            <dt>Status</dt>
            <dd><%- include('../partials/status-pill', { status: project.status }) %></dd>
            <dt>Category</dt>
            <dd><%= project.category %></dd>
            <dt>Visibility</dt>
            <dd><%= project.visibility %></dd>
            <dt>Last updated</dt>
            <dd><%= formatDate(project.updatedAt) %></dd>
          </dl>
        </div>

        <% if (project.externalUrl || project.repoUrl) { %>
        <div class="detail-sidebar__panel card">
          <h3 class="detail-sidebar__heading">Links</h3>
          <ul class="detail-links">
            <% if (project.externalUrl) { %>
              <li>
                <a href="<%= project.externalUrl %>" class="btn btn--primary btn--full" target="_self" rel="noopener">
                  Open Project ↗
                </a>
              </li>
            <% } %>
            <% if (project.repoUrl) { %>
              <li>
                <a href="<%= project.repoUrl %>" class="btn btn--ghost btn--full" target="_blank" rel="noopener">
                  View Source ↗
                </a>
              </li>
            <% } %>
          </ul>
        </div>
        <% } %>

      </aside>

    </div>

  </div>
</div>
