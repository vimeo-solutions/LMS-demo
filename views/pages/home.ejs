<div class="page page--home">

  <!-- Hero -->
  <section class="hero container">
    <div class="hero__content">
      <p class="hero__overline">Home</p>
      <h1 class="hero__heading">My Projects</h1>
      <p class="hero__sub">A collection of internal utilities, demos, prototypes, and notes built to improve workflows and support customers.</p>
      <div class="hero__actions">
        <a href="/demos" class="btn btn--primary">View All Projects</a>
      </div>
    </div>
    <div class="hero__code-badge" aria-hidden="true">
      <pre><span class="cb-punct">&lt;</span><span class="cb-tag">/</span><span class="cb-punct">&gt;</span></pre>
    </div>
  </section>

  <!-- Category cards -->
  <section class="section container">
    <%- include('../partials/section-header', { label: 'Explore', heading: 'What\'s here' }) %>
    <div class="category-grid">

      <a href="/demos" class="category-card">
        <span class="category-card__icon">◈</span>
        <h3 class="category-card__title">Demos</h3>
        <p class="category-card__desc">Demos, proof-of-concepts, and client-facing prototypes.</p>
        <span class="category-card__count"><%= projects.filter(p => p.category === 'Demos').length %> projects</span>
      </a>

      <a href="/api-docs" class="category-card">
        <span class="category-card__icon">≋</span>
        <h3 class="category-card__title">API Docs</h3>
        <p class="category-card__desc">Endpoint notes, integration guides, and code examples.</p>
        <span class="category-card__count"><%= projects.filter(p => p.category === 'API Docs').length %> docs</span>
      </a>

      <a href="/testing" class="category-card">
        <span class="category-card__icon">⚗</span>
        <h3 class="category-card__title">Testing</h3>
        <p class="category-card__desc">Sandboxes, playgrounds, and experimental utilities.</p>
        <span class="category-card__count"><%= projects.filter(p => p.category === 'Testing').length %> tools</span>
      </a>

    </div>
  </section>

  <!-- Featured projects -->
  <% if (featured.length > 0) { %>
  <section class="section container">
    <%- include('../partials/section-header', { label: 'Highlighted', heading: 'Featured Projects' }) %>
    <div class="card-grid">
      <% featured.forEach(function(project) { %>
        <%- include('../partials/project-card', { project }) %>
      <% }); %>
    </div>
  </section>
  <% } %>

  <!-- Quick links -->
  <div class="home-bottom container">

    <aside class="home-bottom__links">
      <h3 class="quick-links__heading">Quick Links</h3>
      <ul class="quick-links">
        <li><a href="https://developer.vimeo.com" class="quick-links__item" target="_blank" rel="noopener">Vimeo API Docs ↗</a></li>
      </ul>
    </aside>

  </div>

</div>
