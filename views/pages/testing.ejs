<div class="page page--index">

  <div class="page-hero container">
    <p class="hero__overline">Sandboxes &amp; Experiments</p>
    <h1 class="page-hero__heading">Testing</h1>
    <p class="page-hero__desc">API playgrounds, webhook testers, request builders, and experimental utilities. Things may break here — that's the point.</p>
  </div>

  <div class="container">

    <div class="experimental-notice">
      <span class="experimental-notice__icon">⚗</span>
      <p>Tools in this section are experimental. They may be incomplete, rough, or change without notice.</p>
    </div>

    <% if (projects.length > 0) { %>
      <div class="card-grid">
        <% projects.forEach(function(project) { %>
          <%- include('../partials/project-card', { project }) %>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state empty-state--framed">
        <span class="empty-state__icon">⚗</span>
        <h3 class="empty-state__heading">No testing tools yet</h3>
        <p class="empty-state__body">Add tools to <code>data/projects.js</code> with <code>category: "Testing"</code>.</p>
      </div>
    <% } %>

  </div>
</div>
