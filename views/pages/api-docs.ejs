    <!-- Doc project cards -->
    <% if (projects.length > 0) { %>
      <div class="card-grid" style="margin-top: var(--space-8)">
        <% projects.forEach(function(project) { %>
          <%- include('../partials/project-card', { project }) %>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state empty-state--framed">
        <span class="empty-state__icon">≋</span>
        <h3 class="empty-state__heading">No API docs yet</h3>
        <p class="empty-state__body">Add doc entries to <code>data/projects.js</code> with <code>category: "API Docs"</code>.</p>
      </div>
    <% } %>

  </div>
</div>
